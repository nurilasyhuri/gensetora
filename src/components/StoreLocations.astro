---
const locations = [
  {
    name: "Workshop Pusat & Pool Staging Unit Genset",
    area: "Pusat Operasional Alat & Mesin",
    address: "Kompleks Pool Genset & Bengkel Perakitan Panel ATS-AMF",
    coverage: "Staging armada rental silent & open type, perakitan panel kontrol otomatis, bengkel bubut & kalibrasi governor.",
    phone: "0851-8300-5070",
    img: "/images/pool-workshop.webp"
  },
  {
    name: "Stasiun Load Bank Testing & Uji Beban Penuh",
    area: "Fasilitas Pengujian & QA/QC Standar Industri",
    address: "Depo Pengujian Beban Resistif & Reaktif 100 kW – 2.000 kW",
    coverage: "Pengujian kapasitas kontinu 100% beban, stabilitas frekuensi 50 Hz, temperatur radiator, dan emisi gas buang.",
    phone: "0851-8300-5070",
    img: "/images/machine-loadbank.webp"
  }
];
---

<section id="fasilitas" class="py-20 sm:py-24 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <div class="text-xs font-bold uppercase tracking-wider text-[#101C2B] bg-[#F5B82E] inline-block px-3 py-1 rounded-md mb-3">
        Fasilitas Fisik &amp; Kesiapan
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#101C2B] tracking-tight">
        Workshop &amp; Fasilitas Uji Beban Terpadu
      </h2>
      <p class="text-sm text-slate-600 mt-2">
        Kami bukan sekadar perantara atau makelar. Setiap unit genset yang keluar dari pool kami telah melewati inspeksi teknis ketat dan uji beban nyata.
      </p>
    </div>

    <!-- 2-Column Physical Facility Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      {locations.map((loc) => (
        <div class="group flex flex-col justify-between space-y-4">
          <div>
            <div class="relative w-full aspect-[16/10] rounded-2xl overflow-hidden mb-4 bg-slate-100 shadow-sm border border-slate-200">
              <img
                src={loc.img}
                alt={loc.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute top-3 left-3 bg-[#101C2B]/90 backdrop-blur-xs text-[#F5B82E] text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-md">
                {loc.area}
              </div>
            </div>

            <h3 class="text-lg sm:text-xl font-heading font-extrabold text-[#101C2B] group-hover:text-[#E5A71D] transition-colors">
              {loc.name}
            </h3>
            
            <p class="text-xs text-slate-700 font-semibold mt-1">
              📍 {loc.address}
            </p>

            <p class="text-xs text-slate-600 leading-relaxed mt-2">
              {loc.coverage}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-500 font-medium">Hotline Workshop:</span>
            <a
              href={`https://wa.me/6285183005070?text=${encodeURIComponent(`Halo Gensetora, saya ingin konsultasi fasilitas dan jadwal survei unit genset di workshop.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold text-emerald-700 hover:text-emerald-800 transition-colors"
            >
              0851-8300-5070 →
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
