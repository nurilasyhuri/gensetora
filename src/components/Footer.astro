---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#101C2B] text-white border-t border-slate-800">
  
  <!-- Top Highlight Strip -->
  <div class="border-b border-slate-800/80 bg-[#0B131E] py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      <div class="py-1 px-3">
        <span class="text-slate-400 block text-[11px] uppercase font-bold tracking-wider">KAPASITAS DAYA</span>
        <span class="font-bold text-[#F5B82E]">1 kVA – 2.000 kVA</span>
      </div>
      <div class="py-1 px-3">
        <span class="text-slate-400 block text-[11px] uppercase font-bold tracking-wider">HOTLINE TEKNISI</span>
        <span class="font-bold text-slate-200">24 Jam Standby</span>
      </div>
      <div class="py-1 px-3">
        <span class="text-slate-400 block text-[11px] uppercase font-bold tracking-wider">WILAYAH OPERASIONAL</span>
        <span class="font-bold text-slate-200">Seluruh Indonesia</span>
      </div>
      <div class="py-1 px-3">
        <span class="text-slate-400 block text-[11px] uppercase font-bold tracking-wider">WORKSHOP PUSAT</span>
        <span class="font-bold text-slate-200">Pool &amp; Uji Beban Load Bank</span>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-12">
      
      <!-- Brand & Profile -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex flex-col group">
          <span class="font-heading text-2xl font-black tracking-widest uppercase text-white group-hover:text-[#F5B82E] transition-colors">
            GENSETORA
          </span>
          <span class="text-xs tracking-wider uppercase text-slate-400 font-semibold">
            PT. GENSETORA DAYA NUSANTARA
          </span>
        </a>

        <p class="text-xs text-slate-400 leading-relaxed pr-4">
          Pusat solusi pembangkit daya terpadu: Penjualan genset baru resmi bergaransi, sewa harian-bulanan lengkap operator &amp; kabel power, servis overhaul mesin diesel, perakitan panel otomatis ATS-AMF, dan pengadaan suku cadang asli di seluruh Indonesia.
        </p>

        <!-- Plain Contact Text -->
        <div class="pt-2 text-xs space-y-1.5 text-slate-300">
          <p><strong>Workshop &amp; Pool:</strong> Kompleks Pool Alat Berat &amp; Staging Gensetora Power</p>
          <p><strong>Hotline Operasional:</strong> <span class="text-[#F5B82E] font-semibold">0851-8300-5070</span> (24 Jam Darurat)</p>
          <p><strong>Cakupan Layanan:</strong> Seluruh Indonesia (Jawa, Sumatera, Kalimantan, Sulawesi, Bali, Nusa Tenggara)</p>
        </div>
      </div>

      <!-- 5 Layanan Spesialis -->
      <div class="space-y-3">
        <h4 class="font-bold text-white text-xs uppercase tracking-wider">Layanan Spesialis</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="#layanan" class="hover:text-[#F5B82E] transition-colors">Jual Genset Baru Bergaransi</a></li>
          <li><a href="#layanan" class="hover:text-[#F5B82E] transition-colors">Sewa Genset Harian &amp; Bulanan</a></li>
          <li><a href="#layanan" class="hover:text-[#F5B82E] transition-colors">Servis &amp; Overhaul Mesin</a></li>
          <li><a href="#layanan" class="hover:text-[#F5B82E] transition-colors">Kontrak Perawatan Berkala K3</a></li>
          <li><a href="#layanan" class="hover:text-[#F5B82E] transition-colors">Fabrikasi Panel ATS-AMF</a></li>
        </ul>
      </div>

      <!-- Kategori Produk -->
      <div class="space-y-3">
        <h4 class="font-bold text-white text-xs uppercase tracking-wider">Kategori Produk</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="#katalog" class="hover:text-[#F5B82E] transition-colors">Silent Canopy Generator</a></li>
          <li><a href="#katalog" class="hover:text-[#F5B82E] transition-colors">Heavy Industrial Diesel Rig</a></li>
          <li><a href="#katalog" class="hover:text-[#F5B82E] transition-colors">Genset Portable Compact</a></li>
          <li><a href="#katalog" class="hover:text-[#F5B82E] transition-colors">Open Type Power Plant</a></li>
          <li><a href="#katalog" class="hover:text-[#F5B82E] transition-colors">Mobile Trailer Genset</a></li>
        </ul>
      </div>

      <!-- Standar Teknis & Artikel -->
      <div class="space-y-3">
        <h4 class="font-bold text-white text-xs uppercase tracking-wider">Standar K3 &amp; Panduan</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><span>Standar ISO 8528 Pembangkit Listrik</span></li>
          <li><span>Fasilitas Uji Beban Load Bank 100%</span></li>
          <li><span>Suku Cadang &amp; Filter Original</span></li>
          <li><span>Kontrak SLA &amp; Garansi Operasional</span></li>
          <li class="pt-1"><a href="/artikel/" class="text-[#F5B82E] font-bold hover:underline">Artikel &amp; Panduan Teknik Genset →</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-400">
        Copyright © {currentYear}, PT. Gensetora Daya Nusantara. Seluruh hak cipta dilindungi undang-undang.
      </p>
      <div class="flex items-center gap-6 text-xs text-slate-400">
        <a href="#top" class="hover:text-slate-300 transition-colors">Kembali ke Atas ↑</a>
      </div>
    </div>
  </div>
</footer>
