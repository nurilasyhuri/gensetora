---
const partnerBrands = [
  "Cummins",
  "Perkins UK",
  "Yanmar",
  "Stamford",
  "Leroy Somer",
  "Mitsubishi",
  "Deep Sea DSE"
];
---

<div class="w-full bg-[#063336] border-y border-[#135D62]/80 py-4 select-none" aria-label="Brand Komponen Resmi">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-center sm:justify-between gap-4 sm:gap-6 text-xs font-bold tracking-widest text-slate-400 uppercase">
      <span class="text-slate-300 font-semibold hidden lg:inline text-xs">Komponen Resmi:</span>
      {partnerBrands.map((brand) => (
        <div class="inline-flex items-center gap-2">
          <span class="text-[#F5B82E]">⚡</span>
          <span class="text-slate-300 hover:text-white transition-colors">{brand}</span>
        </div>
      ))}
    </div>
  </div>
</div>
