---
import { vgenProducts } from '../data/products';
---

<section id="vgen-portable" class="py-20 sm:py-24 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Block -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-12 sm:mb-16 gap-6">
      <div class="max-w-3xl">
        <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-[#101C2B] tracking-tight">
          Lini Genset Portable Open Type V-GEN (Gasoline)
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2 leading-relaxed">
          Genset bensin open type tangguh dengan alternator kawat tembaga murni, starter ganda (electric starter &amp; recoil), dan tangki besar 25 Liter. Tersedia varian 1 Phase 220V hingga varian industri 3 Phase 380V.
        </p>
      </div>

      <!-- Action: Download PDF Brochure -->
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href="/downloads/brosur-vgen-portable-open-type.pdf"
          target="_blank"
          rel="noopener noreferrer"
          download="Brosur-Genset-Portable-VGEN-Rajawali-Diesel.pdf"
          class="inline-flex items-center gap-2.5 px-5 py-3 rounded-lg bg-[#101C2B] hover:bg-slate-800 text-white text-xs font-bold tracking-wide uppercase shadow-sm transition-all group"
        >
          <svg class="w-4 h-4 text-[#F5B82E] group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Unduh Brosur Resmi PDF (3.7 MB)</span>
        </a>

        <a
          href="/produk/"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-slate-300 hover:border-[#101C2B] text-slate-700 hover:text-[#101C2B] text-xs font-bold tracking-wide uppercase transition-colors"
        >
          <span>Lihat Semua Produk &rarr;</span>
        </a>
      </div>
    </div>

    <!-- 5 Product Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {vgenProducts.map((p) => (
        <div class="bg-[#F3F6FA] rounded-2xl border border-slate-200/90 overflow-hidden shadow-xs hover:shadow-xl hover:border-[#F5B82E] transition-all flex flex-col justify-between group">
          
          <div>
            <!-- Top Visual Area -->
            <div class="p-6 bg-gradient-to-b from-white to-[#F3F6FA] border-b border-slate-200/60 relative">
              {p.badge && (
                <div class="absolute top-4 left-4 z-10">
                  <span class="px-3 py-1 rounded-full bg-[#101C2B] text-[#F5B82E] text-[11px] font-bold tracking-wider uppercase shadow-xs">
                    {p.badge}
                  </span>
                </div>
              )}
              <div class="absolute top-4 right-4 z-10">
                <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-700 text-[11px] font-bold tracking-wide">
                  {p.phase}
                </span>
              </div>

              <!-- Product Image -->
              <a href={`/produk/${p.slug}/`} class="block aspect-square max-w-[280px] mx-auto overflow-hidden relative group-hover:scale-105 transition-transform duration-300">
                <img
                  src={p.image}
                  alt={p.name}
                  class="w-full h-full object-contain filter drop-shadow-md"
                  loading="lazy"
                  width="400"
                  height="400"
                />
              </a>
            </div>

            <!-- Content Area -->
            <div class="p-6 space-y-3">
              <!-- Title & Model -->
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block">
                  {p.model}
                </span>
                <h3 class="font-heading font-extrabold text-base text-[#101C2B] group-hover:text-[#E5A71D] transition-colors leading-snug mt-0.5">
                  <a href={`/produk/${p.slug}/`}>
                    {p.name}
                  </a>
                </h3>
              </div>

              <!-- Key Specs Highlight -->
              <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-200 text-xs">
                <div class="bg-white p-2.5 rounded-lg border border-slate-200/80">
                  <span class="text-[9px] text-slate-500 uppercase tracking-wider block font-semibold">Max Output</span>
                  <strong class="text-[#101C2B] font-extrabold text-xs">{p.maxOutput}</strong>
                </div>
                <div class="bg-white p-2.5 rounded-lg border border-slate-200/80">
                  <span class="text-[9px] text-slate-500 uppercase tracking-wider block font-semibold">Rated Output</span>
                  <strong class="text-slate-800 font-bold text-xs">{p.ratedOutput}</strong>
                </div>
              </div>

              <div class="pt-1.5 border-t border-slate-200 text-xs flex justify-between text-slate-600">
                <span>Voltase: <strong class="text-slate-800">{p.voltage}</strong></span>
                <span>Tangki: <strong class="text-slate-800">{p.fuelTank}</strong></span>
              </div>
            </div>
          </div>

          <!-- Bottom Card Buttons -->
          <div class="p-6 pt-0 space-y-2">
            <a
              href={`/produk/${p.slug}/`}
              class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-lg bg-[#101C2B] hover:bg-[#F5B82E] hover:text-[#101C2B] text-white text-xs font-bold tracking-wider uppercase transition-colors shadow-xs"
            >
              <span>Lihat Spesifikasi &rarr;</span>
            </a>
          </div>

        </div>
      ))}

      <!-- 6th Promo / Consultation Card -->
      <div class="bg-[#101C2B] rounded-2xl border border-slate-800 p-8 flex flex-col justify-between text-white relative overflow-hidden shadow-lg">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-[#F5B82E]/10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="space-y-4 relative z-10">
          <span class="text-xs font-bold uppercase tracking-wider text-[#F5B82E] bg-white/10 px-3 py-1 rounded-md inline-block">
            Konsultasi Gratis
          </span>
          <h3 class="font-heading text-2xl font-black leading-snug">
            Bingung Memilih Kapasitas Genset yang Pas?
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Kirimkan daftar beban listrik Anda (AC, freezer, pompa air, mesin las, atau perkakas). Teknisi Gensetora siap menghitung beban puncak dan merekomendasikan tipe genset paling efisien tanpa risiko trip.
          </p>

          <ul class="text-xs text-slate-300 space-y-2 pt-2">
            <li class="flex items-center gap-2">
              <span class="text-[#F5B82E] font-bold">✓</span>
              <span>Perhitungan inrush starting surge 1-Phase &amp; 3-Phase</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#F5B82E] font-bold">✓</span>
              <span>Unit bergaransi resmi distributor Rajawali Diesel</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#F5B82E] font-bold">✓</span>
              <span>Pengiriman dan pengetesan unit sebelum kirim</span>
            </li>
          </ul>
        </div>

        <div class="pt-6 relative z-10 space-y-3">
          <a
            href="https://wa.me/6285183005070?text=Halo%20Gensetora%2C%20saya%20ingin%20konsultasi%20pemilihan%20kapasitas%20genset%20portable%20V-GEN%20yang%20sesuai%20kebutuhan."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-lg bg-[#F5B82E] hover:bg-[#E5A71D] text-[#101C2B] font-bold text-xs uppercase tracking-wider transition-colors shadow-md"
          >
            <span>Chat WhatsApp Ahli Genset</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/downloads/brosur-vgen-portable-open-type.pdf"
            target="_blank"
            download
            class="w-full inline-flex items-center justify-center py-2 px-4 rounded-lg border border-slate-700 text-slate-300 hover:text-white hover:border-slate-500 text-xs font-semibold tracking-wide transition-colors"
          >
            Download Lembar Brosur PDF
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
