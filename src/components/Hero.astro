---
---

<section class="relative w-full min-h-[520px] lg:min-h-[640px] bg-[#101C2B] text-white overflow-hidden flex flex-col justify-between py-12 sm:py-16 lg:py-24" aria-label="Gensetora Power Showcase">
  <!-- Background Image with Gradient Overlay -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute inset-0 opacity-100 z-10">
      <img
        src="/images/hero-bg.webp"
        alt="Gensetora — Complete Generator and Power Solutions Indonesia"
        class="w-full h-full object-cover object-center filter brightness-[0.38] contrast-[1.2]"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0B131E]/95 via-[#101C2B]/80 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#101C2B] via-transparent to-[#0B131E]/60"></div>
    </div>
  </div>

  <!-- Decorative Top Ambient Glow -->
  <div class="absolute top-1/4 left-10 w-96 h-96 bg-[#F5B82E]/10 rounded-full blur-3xl pointer-events-none z-0"></div>

  <!-- Main Hero Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-16 sm:pt-20">
    <div class="max-w-3xl space-y-6 sm:space-y-8">
      
      <!-- Core Headline -->
      <h1 class="font-heading text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.15]">
        Solusi Genset Andal untuk Rumah, Bisnis & Kebutuhan Industri
      </h1>

      <!-- Supporting Paragraph -->
      <p class="text-sm sm:text-base lg:text-lg text-slate-300 font-normal leading-relaxed max-w-2xl">
        Pusat genset terpadu kapasitas 1 kVA – 2.000 kVA di seluruh Indonesia. Melayani penjualan unit baru bergaransi, sewa/rental harian hingga tahunan, servis overhaul mesin, dan instalasi panel ATS otomatis.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
        <a
          href="#kalkulator"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg bg-[#F5B82E] hover:bg-[#E5A71D] text-[#101C2B] font-bold text-xs sm:text-sm tracking-wide uppercase shadow-lg shadow-amber-950/20 active:scale-95 transition-all"
        >
          Hitung Kebutuhan Daya (Kalkulator)
        </a>
        <a
          href="#katalog"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg border border-slate-600 hover:border-[#F5B82E] hover:text-[#F5B82E] text-slate-200 text-xs sm:text-sm font-semibold tracking-wide uppercase transition-colors"
        >
          Lihat Katalog Genset
        </a>
      </div>

    </div>
  </div>

  <!-- Bottom Metric Bar (Mechline Industrial Strip Pattern) -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-12 sm:mt-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 pt-6 border-t border-slate-800/80">
      <div class="space-y-1">
        <div class="font-heading text-xl sm:text-2xl font-black text-[#F5B82E]">1 – 2.000 kVA</div>
        <div class="text-xs text-slate-400 font-medium">Rentang Kapasitas Lengkap</div>
      </div>
      <div class="space-y-1">
        <div class="font-heading text-xl sm:text-2xl font-black text-white">&lt; 15 Menit</div>
        <div class="text-xs text-slate-400 font-medium">Respon Cepat Tim Teknis</div>
      </div>
      <div class="space-y-1">
        <div class="font-heading text-xl sm:text-2xl font-black text-white">100% Asli</div>
        <div class="text-xs text-slate-400 font-medium">Garansi Mesin &amp; Suku Cadang</div>
      </div>
      <div class="space-y-1">
        <div class="font-heading text-xl sm:text-2xl font-black text-[#F5B82E]">500+ Unit</div>
        <div class="text-xs text-slate-400 font-medium">Terpasang &amp; Armada Rental</div>
      </div>
    </div>
  </div>
</section>
