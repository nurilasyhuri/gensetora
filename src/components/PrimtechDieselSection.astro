---
import { primtechProducts } from '../data/products';
---

<section id="primtech-diesel" class="py-20 sm:py-24 bg-[#101C2B] text-white border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Block -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-12 sm:mb-16 gap-6">
      <div class="max-w-3xl">
        <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Lini Genset Diesel Industri PRIMTECH (20 – 500 kVA)
        </h2>
        <p class="text-sm sm:text-base text-slate-300 mt-2 leading-relaxed">
          Pembangkit listrik diesel tugas berat ditenagai mesin YUNNEI Common Rail, pengaturan putaran elektronik presisi (Electronic Speed Control), dan controller cerdas SmartGen. Tersedia dalam varian Silent Canopy kedap suara (&lt; 68 dB) dan Open Type untuk ruang power house.
        </p>
      </div>

      <!-- Action: Download PDF Catalog -->
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href="/downloads/katalog-genset-diesel-primtech-prime-series.pdf"
          target="_blank"
          download="Katalog-Genset-Diesel-PRIMTECH-Prime-Series.pdf"
          class="inline-flex items-center gap-2.5 px-5 py-3 rounded-lg bg-[#F5B82E] hover:bg-[#E5A71D] text-[#101C2B] font-bold text-xs uppercase tracking-wider shadow-md transition-all group"
        >
          <svg class="w-4 h-4 text-[#101C2B] group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Unduh Katalog PRIMTECH PDF</span>
        </a>

        <a
          href="/produk/"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-slate-700 hover:border-slate-400 text-slate-300 hover:text-white text-xs font-semibold tracking-wide uppercase transition-colors"
        >
          <span>Lihat Semua Produk &rarr;</span>
        </a>
      </div>
    </div>

    <!-- Product Cards Grid (4 Columns) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {primtechProducts.map((p) => (
        <div class="bg-[#162538] rounded-2xl border border-slate-700/80 overflow-hidden shadow-lg hover:border-[#F5B82E] transition-all flex flex-col justify-between group">
          
          <div>
            <!-- Top Visual Area -->
            <div class="p-6 bg-[#0B131E]/60 border-b border-slate-800 relative">
              {p.badge && (
                <div class="absolute top-3 left-3 z-10">
                  <span class="px-2.5 py-1 rounded-full bg-[#101C2B] border border-[#F5B82E]/40 text-[#F5B82E] text-[10px] font-bold tracking-wider uppercase">
                    {p.badge}
                  </span>
                </div>
              )}
              <div class="absolute top-3 right-3 z-10">
                <span class="px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-300 text-[10px] font-semibold">
                  3-Phase 400V
                </span>
              </div>

              <!-- Product Image -->
              <a href={`/produk/${p.slug}/`} class="block aspect-square max-w-[240px] mx-auto overflow-hidden relative group-hover:scale-105 transition-transform duration-300">
                <img
                  src={p.image}
                  alt={p.name}
                  class="w-full h-full object-contain filter drop-shadow-md"
                  loading="lazy"
                  width="400"
                  height="400"
                />
              </a>
            </div>

            <!-- Content Area -->
            <div class="p-5 space-y-3">
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                  {p.brand} • {p.series}
                </span>
                <h3 class="font-heading font-extrabold text-base text-white group-hover:text-[#F5B82E] transition-colors leading-snug mt-1">
                  <a href={`/produk/${p.slug}/`}>
                    {p.name}
                  </a>
                </h3>
                <p class="text-xs text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                  {p.shortDesc}
                </p>
              </div>

              <!-- Key Specs Highlight -->
              <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800 text-xs">
                <div class="bg-[#0B131E] p-2 rounded-lg border border-slate-800">
                  <span class="text-[9px] text-slate-400 uppercase tracking-wider block font-medium">Prime Power</span>
                  <strong class="text-[#F5B82E] font-black text-xs">{p.ratedOutput.split('(')[0]}</strong>
                </div>
                <div class="bg-[#0B131E] p-2 rounded-lg border border-slate-800">
                  <span class="text-[9px] text-slate-400 uppercase tracking-wider block font-medium">Standby Power</span>
                  <strong class="text-white font-bold text-xs">{p.maxOutput.split('(')[0]}</strong>
                </div>
              </div>

              <div class="space-y-1 text-[11px] pt-1 border-t border-slate-800 text-slate-400">
                <div class="flex justify-between">
                  <span>Engine:</span>
                  <strong class="text-slate-200 truncate max-w-[140px]">{p.engine?.split('(')[0]}</strong>
                </div>
                <div class="flex justify-between">
                  <span>Konsumsi:</span>
                  <strong class="text-emerald-400">{p.fuelConsumption?.split('•')[0]}</strong>
                </div>
                <div class="flex justify-between">
                  <span>Controller:</span>
                  <strong class="text-slate-200">SmartGen</strong>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Card Buttons -->
          <div class="p-5 pt-0 space-y-2">
            <a
              href={`https://wa.me/6285183005070?text=${encodeURIComponent(`Halo Gensetora, saya tertarik menanyakan harga dan spesifikasi teknis ${p.name} (${p.model}). Mohon informasi penawaran resminya.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg bg-[#F5B82E] hover:bg-[#E5A71D] text-[#101C2B] text-xs font-bold tracking-wider uppercase transition-colors"
            >
              <span>Minta Penawaran</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a
              href={`/produk/${p.slug}/`}
              class="w-full inline-flex items-center justify-center py-2 px-3 rounded-lg text-slate-400 hover:text-white text-xs font-semibold tracking-wide transition-colors"
            >
              Lihat Detail &rarr;
            </a>
          </div>

        </div>
      ))}
    </div>

    <!-- Technical Comparison Matrix for PRIMTECH -->
    <div class="mt-16 bg-[#162538] border border-slate-700/80 rounded-2xl p-6 sm:p-8">
      <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="font-heading font-extrabold text-lg sm:text-xl text-white">
            Tabel Komparasi Seri Genset Diesel PRIMTECH
          </h3>
          <p class="text-xs text-slate-400 mt-1">
            Parameter teknis Prime Power, Standby Power, tipe mesin, dan efisiensi konsumsi solar pada beban 100%.
          </p>
        </div>
        <a
          href="/downloads/katalog-genset-diesel-primtech-prime-series.pdf"
          target="_blank"
          download
          class="inline-flex items-center gap-2 text-xs font-bold text-[#F5B82E] hover:underline"
        >
          <span>Download Tabel Lengkap PDF</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-700 bg-[#0B131E] text-slate-300">
              <th class="py-3 px-4 font-bold uppercase tracking-wider">Model</th>
              <th class="py-3 px-4 font-bold uppercase tracking-wider">Prime Power</th>
              <th class="py-3 px-4 font-bold uppercase tracking-wider">Standby Power</th>
              <th class="py-3 px-4 font-bold uppercase tracking-wider">Mesin Diesel</th>
              <th class="py-3 px-4 font-bold uppercase tracking-wider">Speed Control</th>
              <th class="py-3 px-4 font-bold uppercase tracking-wider">Konsumsi 100%</th>
              <th class="py-3 px-4 font-bold uppercase tracking-wider">Berat Silent</th>
              <th class="py-3 px-4 font-bold uppercase tracking-wider text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-slate-300">
            {primtechProducts.map((p) => (
              <tr class="hover:bg-[#101C2B]/80 transition-colors">
                <td class="py-3.5 px-4 font-bold text-white">
                  <a href={`/produk/${p.slug}/`} class="hover:text-[#F5B82E] transition-colors">
                    {p.model}
                  </a>
                </td>
                <td class="py-3.5 px-4 font-black text-[#F5B82E]">{p.ratedOutput.split('(')[0]}</td>
                <td class="py-3.5 px-4 font-bold text-white">{p.maxOutput.split('(')[0]}</td>
                <td class="py-3.5 px-4 text-slate-300">{p.engine?.split('(')[0]}</td>
                <td class="py-3.5 px-4">
                  <span class={`px-2 py-0.5 rounded text-[10px] font-semibold ${p.speedControl?.includes('Common Rail') ? 'bg-cyan-900/60 text-cyan-300 border border-cyan-700/60' : 'bg-slate-800 text-slate-300'}`}>
                    {p.speedControl?.includes('Common Rail') ? 'Common Rail' : 'Electronic'}
                  </span>
                </td>
                <td class="py-3.5 px-4 text-emerald-400 font-mono">{p.fuelConsumption?.split('•')[0]}</td>
                <td class="py-3.5 px-4">{p.weight.split('|')[0].replace('Silent: ', '')}</td>
                <td class="py-3.5 px-4 text-right">
                  <a
                    href={`/produk/${p.slug}/`}
                    class="inline-block px-3 py-1 rounded bg-[#0B131E] border border-slate-700 hover:border-[#F5B82E] hover:text-[#F5B82E] text-white text-[11px] font-bold uppercase tracking-wider transition-colors"
                  >
                    Detail
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>
