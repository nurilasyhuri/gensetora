---
import { getCollection } from 'astro:content';

const allArticles = await getCollection('artikel');

function parseArticleDate(str: string): number {
  if (!str) return 0;
  const iso = Date.parse(str);
  if (!isNaN(iso)) return iso;
  const idMonths: Record<string, number> = {
    januari: 0, februari: 1, maret: 2, april: 3, mei: 4, juni: 5,
    juli: 6, agustus: 7, september: 8, oktober: 9, november: 10, desember: 11
  };
  const parts = str.trim().split(/\s+/);
  if (parts.length === 3) {
    const day = parseInt(parts[0], 10);
    const month = idMonths[parts[1].toLowerCase()];
    const year = parseInt(parts[2], 10);
    if (!isNaN(day) && month !== undefined && !isNaN(year)) {
      return new Date(year, month, day).getTime();
    }
  }
  return 0;
}

const sortedArticles = [...allArticles].sort(
  (a, b) => parseArticleDate(b.data.publishDate) - parseArticleDate(a.data.publishDate)
);
const featuredArticles = sortedArticles.slice(0, 3);
---

<section id="artikel" class="py-20 sm:py-24 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-[#101C2B] tracking-tight">
          Panduan Praktis &amp; Standar Teknik Genset
        </h2>
        <p class="text-sm sm:text-base text-slate-600 max-w-2xl mt-2 leading-relaxed">
          Edukasi teknis mengenai perhitungan daya listrik kVA vs kW, prosedur perawatan mesin diesel, sistem otomatisasi ATS-AMF, dan efisiensi konsumsi BBM.
        </p>
      </div>

      <a
        href="/artikel/"
        class="text-xs font-bold text-[#101C2B] hover:text-[#E5A71D] uppercase tracking-wider inline-flex items-center gap-1.5 shrink-0 transition-colors"
      >
        <span>Lihat Semua {allArticles.length} Panduan Teknis</span>
        <svg class="w-4 h-4 text-[#F5B82E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- 3-Column Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredArticles.map((item) => (
        <article class="bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-xs hover:shadow-lg transition-all flex flex-col justify-between group">
          <div>
            <div class="block aspect-video overflow-hidden bg-slate-900 relative">
              <img
                src={item.data.heroImage}
                alt={`Ilustrasi ${item.data.title}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out"
                loading="lazy"
              />
              <div class="absolute top-2.5 left-2.5">
                <span class="px-2.5 py-1 rounded-md bg-[#101C2B]/90 backdrop-blur-xs text-[#F5B82E] text-xs font-bold uppercase tracking-wider">
                  {item.data.category}
                </span>
              </div>
            </div>

            <div class="p-5 sm:p-6 space-y-3">
              <div class="text-[11px] text-slate-500 font-medium">
                <time datetime={item.data.publishDate}>{item.data.publishDate}</time>
              </div>

              <h3 class="font-heading font-extrabold text-base sm:text-lg text-[#101C2B] group-hover:text-[#E5A71D] transition-colors leading-snug line-clamp-2">
                <a href={`/artikel/${item.slug}/`}>
                  {item.data.title}
                </a>
              </h3>

              <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed">
                {item.data.description}
              </p>
            </div>
          </div>

          <div class="p-5 sm:p-6 pt-0 border-t border-slate-100 mt-2">
            <a
              href={`/artikel/${item.slug}/`}
              class="inline-flex items-center gap-1.5 text-xs font-bold text-[#101C2B] group-hover:text-[#E5A71D] uppercase tracking-wider transition-colors"
            >
              <span>Baca Selengkapnya</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
