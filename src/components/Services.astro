---
const services = [
  {
    num: "01",
    title: "Penjualan Genset Baru Bergaransi",
    desc: "Pengadaan unit genset baru silent maupun open type kapasitas 10 – 2.000 kVA dengan garansi pabrik resmi 1–2 tahun. Lengkap COO, test report pabrik, dan suku cadang terjamin.",
    tag: "Garansi 1-2 Tahun"
  },
  {
    num: "02",
    title: "Rental & Sewa Genset Harian - Bulanan",
    desc: "Layanan rental genset siap kirim untuk event, pabrik, konstruksi, dan backup darurat. Sudah termasuk kabel power tembaga, tangki solar harian, dan teknisi standby di lokasi.",
    tag: "Paket All-In + Operator"
  },
  {
    num: "03",
    title: "Servis Mesin, Overhaul & Dinamo",
    desc: "Penanganan perbaikan mesin genset: top overhaul, general overhaul, kalibrasi injector pump & governor, penggantian turbocharger, serta rewinding dinamo alternator.",
    tag: "Teknisi Bersertifikat"
  },
  {
    num: "04",
    title: "Kontrak Maintenance Berkala (SOP K3)",
    desc: "Program preventive maintenance rutin bulanan atau 250 jam kerja. Pengecekan 30 parameter mekanik-elektrikal, ganti oli mesin, kuras filter, dan uji fungsi baterai starter.",
    tag: "SLA Respon Darurat"
  },
  {
    num: "05",
    title: "Panel ATS-AMF & Sistem Synchronizing",
    desc: "Fabrikasi panel kontrol otomatis ATS-AMF (Auto Transfer Switch) dengan modul DSE/ComAp. Listrik otomatis berpindah dari PLN ke genset dalam 5–10 detik saat pemadaman.",
    tag: "Otomatis 5-10 Detik"
  }
];

const steps = [
  {
    num: "01",
    title: "Konsultasi Daya",
    desc: "Perhitungan beban total Watt/kVA, lonjakan starting motor, dan penentuan voltase sistem 1 atau 3 phase."
  },
  {
    num: "02",
    title: "Penawaran Resmi (RFQ)",
    desc: "Penerbitan surat penawaran harga transparan mencakup spesifikasi unit, termin garansi, dan jadwal kirim."
  },
  {
    num: "03",
    title: "Mobilisasi & Instalasi",
    desc: "Pengiriman unit via truk crane, pemasangan kabel power, grounding K3, dan integrasi panel kontrol ATS."
  },
  {
    num: "04",
    title: "Uji Beban & Serah Terima",
    desc: "Commissioning test dan load bank testing beban 100% sebelum berita acara serah terima resmi ditandatangani."
  }
];
---

<section id="layanan" class="py-20 sm:py-24 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <div class="text-xs font-bold uppercase tracking-wider text-[#0A4347] bg-[#F5B82E] inline-block px-3 py-1 rounded-md mb-3">
        Layanan Spesialis
      </div>
      <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-[#0A4347] tracking-normal">
        Layanan Lengkap Solusi Pembangkit Daya
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2 leading-relaxed">
        Dari pengadaan genset baru, penyewaan jangka pendek/panjang, perbaikan darurat, hingga kontrak perawatan berkala untuk memastikan operasional bisnis Anda tidak pernah terhenti.
      </p>
    </div>

    <!-- 5 Core Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((srv, idx) => (
        <div class={`p-7 rounded-2xl border transition-[background-color,border-color,box-shadow] duration-200 flex flex-col justify-between group ${
          idx === 0 
            ? 'bg-[#0A4347] text-white border-[#074549] shadow-md md:col-span-2 lg:col-span-1' 
            : 'bg-slate-50 border-slate-200/90 hover:border-[#009498] hover:bg-white hover:shadow-md text-slate-900'
        }`}>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class={`text-2xl font-black font-heading ${idx === 0 ? 'text-[#F5B82E]' : 'text-slate-600 group-hover:text-[#009498]'}`}>
                {srv.num}
              </span>
              <span class={`text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md ${
                idx === 0 ? 'bg-[#063336] text-[#F5B82E]' : 'bg-white border border-slate-200 text-slate-600 group-hover:border-[#009498]'
              }`}>
                {srv.tag}
              </span>
            </div>

            <h3 class={`font-heading font-extrabold text-lg sm:text-xl leading-snug ${idx === 0 ? 'text-white' : 'text-[#0A4347]'}`}>
              {srv.title}
            </h3>

            <p class={`text-xs sm:text-sm leading-relaxed ${idx === 0 ? 'text-slate-300' : 'text-slate-600'}`}>
              {srv.desc}
            </p>
          </div>

          <div class="pt-6 mt-4 border-t border-slate-200/50">
            <a
              href="#kontak"
              class={`inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider transition-colors ${
                idx === 0 ? 'text-[#F5B82E] hover:underline' : 'text-[#009498] group-hover:text-[#095257]'
              }`}
            >
              <span>Pelajari Layanan</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- 4-Step Process Strip -->
    <div class="mt-20 pt-16 border-t border-slate-200">
      <div class="max-w-2xl mb-10">
        <h3 class="font-heading text-xl sm:text-2xl font-extrabold text-[#0A4347] tracking-normal">
          Alur Kerja &amp; Eksekusi Berstandar K3
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Tahapan penanganan transparan dari awal perhitungan beban hingga unit menyala stabil di lokasi Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {steps.map((st) => (
          <div class="p-6 rounded-2xl bg-[#EFF8F8] border border-slate-200 space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-xl font-black text-[#0A4347] font-heading">{st.num}</span>
              <span class="w-2 h-2 rounded-full bg-[#009498]"></span>
            </div>
            <h4 class="font-heading font-bold text-sm sm:text-base text-[#0A4347]">{st.title}</h4>
            <p class="text-xs text-slate-600 leading-relaxed">{st.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
