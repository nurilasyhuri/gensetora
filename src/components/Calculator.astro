---
---

<section id="kalkulator" class="py-20 sm:py-24 bg-[#101C2B] text-white border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Kalkulator Kebutuhan Kapasitas Genset (kVA)
      </h2>
      <p class="text-sm sm:text-base text-slate-300 mt-2 leading-relaxed">
        Hitung rekomendasi kapasitas genset yang aman berdasarkan total beban daya berjalan, lonjakan arus starting peralatan induktif, dan batas aman beban operasional (*safe load factor 80%*).
      </p>
    </div>

    <!-- Calculator Grid: Input Column & Output Result Card -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Input Form Card -->
      <div class="lg:col-span-7 bg-[#162538] border border-slate-700/80 rounded-2xl p-6 sm:p-8 space-y-6 shadow-xl">
        
        <!-- Field 1: Aplikasi Fasilitas -->
        <div class="space-y-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-200">
            1. Peruntukan / Jenis Fasilitas
          </label>
          <select
            id="calc_application"
            class="w-full bg-[#0B131E] border border-slate-700 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-[#F5B82E] transition-colors"
          >
            <option value="rumah" data-surge="1.5" data-phase="1">Rumah Tinggal Bertingkat (AC, Kulkas, Pompa Air)</option>
            <option value="ruko" data-surge="1.75" data-phase="1" selected>Ruko, Kafe &amp; Restoran (Chiller, Lampu, Komputer, AC)</option>
            <option value="kantor" data-surge="1.8" data-phase="3">Gedung Kantor &amp; Klinik Medis (Server IT, AC Sentral)</option>
            <option value="pabrik" data-surge="2.2" data-phase="3">Pabrik Industri &amp; Gudang (Motor Induksi, Kompresor)</option>
            <option value="event" data-surge="1.5" data-phase="3">Event Konser Outdoor &amp; Panggung (Lighting, Sound System)</option>
          </select>
        </div>

        <!-- Field 2: Total Daya Beban Berjalan (Running Load) -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-200">
              2. Total Daya Berjalan (Running Load)
            </label>
            <span class="text-sm font-black text-[#F5B82E] font-heading" id="calc_watt_display">
              15.000 Watt (15 kW)
            </span>
          </div>
          <input
            type="range"
            id="calc_watt_range"
            min="2000"
            max="250000"
            step="1000"
            value="15000"
            class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-[#F5B82E]"
          />
          <div class="flex justify-between text-[11px] text-slate-400">
            <span>2 kW (Rumah)</span>
            <span>50 kW (Ruko/Kantor)</span>
            <span>150 kW (Gedung)</span>
            <span>250 kW+ (Pabrik)</span>
          </div>
        </div>

        <!-- Field 3: Lonjakan Beban Starting (Starting Surge) -->
        <div class="space-y-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-200">
            3. Faktor Lonjakan Starting Arus Motor
          </label>
          <div class="grid grid-cols-3 gap-3">
            <button
              type="button"
              class="surge-btn py-2.5 px-3 rounded-lg border border-slate-700 bg-[#0B131E] text-xs font-semibold text-slate-300 hover:border-[#F5B82E] transition-all text-center"
              data-factor="1.25"
            >
              Rendah (1.25x)<br><span class="text-[10px] text-slate-400">Lampu &amp; Elektronik</span>
            </button>
            <button
              type="button"
              class="surge-btn py-2.5 px-3 rounded-lg border border-[#F5B82E] bg-[#F5B82E]/10 text-xs font-semibold text-[#F5B82E] transition-all text-center"
              data-factor="1.5"
            >
              Standar (1.5x)<br><span class="text-[10px] text-slate-300">AC &amp; Kulkas</span>
            </button>
            <button
              type="button"
              class="surge-btn py-2.5 px-3 rounded-lg border border-slate-700 bg-[#0B131E] text-xs font-semibold text-slate-300 hover:border-[#F5B82E] transition-all text-center"
              data-factor="2.2"
            >
              Tinggi (2.2x)<br><span class="text-[10px] text-slate-400">Chiller &amp; Motor 3-Ph</span>
            </button>
          </div>
        </div>

        <!-- Field 4: Sistem Tegangan Listrik (Phase) & Panel ATS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-200">
              4. Sistem Listrik (Phase)
            </label>
            <select
              id="calc_phase"
              class="w-full bg-[#0B131E] border border-slate-700 rounded-lg px-4 py-2.5 text-xs sm:text-sm text-white focus:outline-none focus:border-[#F5B82E]"
            >
              <option value="1">1 Phase (220 Volt)</option>
              <option value="3" selected>3 Phase (380 Volt / R-S-T-N)</option>
            </select>
          </div>

          <div class="space-y-2">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-200">
              5. Pasang Panel Otomatis ATS-AMF?
            </label>
            <select
              id="calc_ats"
              class="w-full bg-[#0B131E] border border-slate-700 rounded-lg px-4 py-2.5 text-xs sm:text-sm text-white focus:outline-none focus:border-[#F5B82E]"
            >
              <option value="ya" selected>Ya (Otomatis Nyala 5 Detik)</option>
              <option value="tidak">Tidak (Manual Switch COS)</option>
            </select>
          </div>
        </div>

        <!-- Footnote Warning -->
        <p class="text-[11px] text-slate-400 leading-relaxed border-t border-slate-700/60 pt-4">
          ⚠️ <em>Catatan teknis:</em> Perhitungan ini menggunakan rumus standar faktor daya listrik ($\cos \phi = 0.8$) dengan cadangan beban aman (*load factor 80%*) agar mesin genset tidak mengalami *overheating*. Hasil akhir wajib diverifikasi teknisi lapangan.
        </p>

      </div>

      <!-- Output Result Card -->
      <div class="lg:col-span-5 bg-[#0B131E] border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6 shadow-2xl relative overflow-hidden">
        
        <div class="absolute -right-12 -top-12 w-44 h-44 bg-[#F5B82E]/10 rounded-full blur-2xl pointer-events-none"></div>

        <div>
          <span class="text-xs uppercase font-bold tracking-wider text-slate-400">Rekomendasi Kapasitas Genset</span>
          <div class="flex items-baseline gap-2 mt-2">
            <span class="text-4xl sm:text-5xl font-black font-heading text-[#F5B82E]" id="calc_res_kva">
              25 kVA
            </span>
            <span class="text-sm font-semibold text-slate-300">Prime Power</span>
          </div>
          <div class="text-xs text-slate-400 mt-1" id="calc_res_kw">
            Setara daya aktif: 20.0 kW
          </div>
        </div>

        <!-- Result Parameter Breakdown -->
        <div class="space-y-3 pt-4 border-t border-slate-800 text-xs">
          <div class="flex justify-between items-center py-1">
            <span class="text-slate-400">Tipe Genset Disarankan:</span>
            <strong class="text-white font-semibold text-right" id="calc_res_type">Silent Soundproof Canopy</strong>
          </div>
          <div class="flex justify-between items-center py-1">
            <span class="text-slate-400">Sistem Voltase:</span>
            <strong class="text-white font-semibold" id="calc_res_phase">3 Phase (380 Volt)</strong>
          </div>
          <div class="flex justify-between items-center py-1">
            <span class="text-slate-400">Panel ATS Otomatis:</span>
            <strong class="text-emerald-400 font-semibold" id="calc_res_ats">Termasuk Modul DSE</strong>
          </div>
          <div class="flex justify-between items-center py-1">
            <span class="text-slate-400">Rekomendasi Engine:</span>
            <strong class="text-slate-200 font-semibold" id="calc_res_engine">Cummins / Perkins / Yanmar</strong>
          </div>
          <div class="flex justify-between items-center py-1">
            <span class="text-slate-400">Estimasi Konsumsi Solar:</span>
            <strong class="text-[#F5B82E] font-semibold" id="calc_res_fuel">± 4.5 – 5.5 Liter / Jam (Beban 75%)</strong>
          </div>
        </div>

        <!-- WhatsApp Action Button with Template Text -->
        <div class="pt-4 border-t border-slate-800 space-y-3">
          <a
            id="calc_btn_whatsapp"
            href="https://wa.me/6285183005070"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-lg bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-xs sm:text-sm tracking-wide uppercase transition-all shadow-lg active:scale-95"
          >
            <span>Kirim Hasil ke WhatsApp Estimator</span>
            <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.54 1.767.828 2.796.828h.005c3.181 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.766-5.768-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.708 0-3.32-.43-4.743-1.189l-5.257 1.378 1.4-5.118c-.85-1.488-1.341-3.21-1.341-5.043 0-5.514 4.486-10 10-10s10 4.486 10 10z"/>
            </svg>
          </a>
          <div class="text-[11px] text-center text-slate-400">
            Respon cepat tim teknis genset dalam 15 menit via WhatsApp.
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  function setupCalculator() {
    const appSelect = document.getElementById('calc_application') as HTMLSelectElement;
    const wattRange = document.getElementById('calc_watt_range') as HTMLInputElement;
    const wattDisplay = document.getElementById('calc_watt_display') as HTMLSpanElement;
    const phaseSelect = document.getElementById('calc_phase') as HTMLSelectElement;
    const atsSelect = document.getElementById('calc_ats') as HTMLSelectElement;
    const surgeButtons = document.querySelectorAll('.surge-btn');

    const resKva = document.getElementById('calc_res_kva') as HTMLSpanElement;
    const resKw = document.getElementById('calc_res_kw') as HTMLDivElement;
    const resType = document.getElementById('calc_res_type') as HTMLElement;
    const resPhase = document.getElementById('calc_res_phase') as HTMLElement;
    const resAts = document.getElementById('calc_res_ats') as HTMLElement;
    const resFuel = document.getElementById('calc_res_fuel') as HTMLElement;
    const btnWa = document.getElementById('calc_btn_whatsapp') as HTMLAnchorElement;

    let currentSurgeFactor = 1.5;

    function calculate() {
      const runningWatt = parseFloat(wattRange.value) || 15000;
      wattDisplay.textContent = `${runningWatt.toLocaleString('id-ID')} Watt (${(runningWatt / 1000).toFixed(1)} kW)`;

      // Rumus: Kapasitas kVA = (Running kW * Surge Factor) / (Power Factor 0.8 * Safe Load Factor 0.8)
      const runningKw = runningWatt / 1000;
      const calculatedKvaRaw = (runningKw * currentSurgeFactor) / 0.8 / 0.8;

      // Standar ukuran genset pasar di Indonesia
      const standardKvas = [10, 15, 20, 25, 30, 40, 50, 60, 80, 100, 135, 150, 200, 250, 300, 400, 500, 650, 800, 1000, 1250, 1500, 2000];
      let selectedKva = standardKvas[standardKvas.length - 1];
      for (const k of standardKvas) {
        if (k >= calculatedKvaRaw) {
          selectedKva = k;
          break;
        }
      }

      resKva.textContent = `${selectedKva} kVA`;
      resKw.textContent = `Setara daya aktif: ${(selectedKva * 0.8).toFixed(0)} kW`;

      const isThreePhase = phaseSelect.value === '3';
      resPhase.textContent = isThreePhase ? '3 Phase (380 Volt)' : '1 Phase (220 Volt)';

      const withAts = atsSelect.value === 'ya';
      resAts.textContent = withAts ? 'Termasuk Panel ATS-AMF' : 'Tanpa Panel ATS (Manual COS)';

      if (selectedKva <= 15) {
        resType.textContent = 'Silent Canopy / Portable Compact';
      } else if (selectedKva <= 500) {
        resType.textContent = 'Silent Soundproof Canopy';
      } else {
        resType.textContent = 'Heavy Duty Industrial (Open / Silent)';
      }

      // Estimasi konsumsi bahan bakar solar (rata-rata 0.22 liter per kVA per jam pada beban 75%)
      const fuelMin = (selectedKva * 0.18).toFixed(1);
      const fuelMax = (selectedKva * 0.23).toFixed(1);
      resFuel.textContent = `± ${fuelMin} – ${fuelMax} Liter / Jam (Beban 75%)`;

      const appLabel = appSelect.options[appSelect.selectedIndex].text;
      const waText = 
`Halo Estimator Gensetora, saya ingin konsultasi kebutuhan genset berdasarkan kalkulator daya:
• Peruntukan: ${appLabel}
• Beban Berjalan: ${(runningWatt/1000).toFixed(1)} kW (${runningWatt.toLocaleString('id-ID')} Watt)
• Faktor Starting Surge: ${currentSurgeFactor}x
• Sistem Listrik: ${isThreePhase ? '3 Phase (380V)' : '1 Phase (220V)'}
• Kebutuhan Panel ATS: ${withAts ? 'Ya (Otomatis)' : 'Tidak (Manual)'}
• Rekomendasi Sistem: ${selectedKva} kVA

Mohon informasi ketersediaan unit, opsi jual/sewa, dan penawaran resmi. Terima kasih.`;

      btnWa.href = `https://wa.me/6285183005070?text=${encodeURIComponent(waText)}`;
    }

    wattRange.addEventListener('input', calculate);
    appSelect.addEventListener('change', () => {
      const selectedOption = appSelect.options[appSelect.selectedIndex];
      const defaultSurge = parseFloat(selectedOption.getAttribute('data-surge') || '1.5');
      const defaultPhase = selectedOption.getAttribute('data-phase') || '3';
      currentSurgeFactor = defaultSurge;
      phaseSelect.value = defaultPhase;

      surgeButtons.forEach((b) => {
        const factor = parseFloat(b.getAttribute('data-factor') || '1.5');
        if (Math.abs(factor - defaultSurge) < 0.1) {
          b.className = 'surge-btn py-2.5 px-3 rounded-lg border border-[#F5B82E] bg-[#F5B82E]/10 text-xs font-semibold text-[#F5B82E] transition-all text-center';
        } else {
          b.className = 'surge-btn py-2.5 px-3 rounded-lg border border-slate-700 bg-[#0B131E] text-xs font-semibold text-slate-300 hover:border-[#F5B82E] transition-all text-center';
        }
      });
      calculate();
    });

    phaseSelect.addEventListener('change', calculate);
    atsSelect.addEventListener('change', calculate);

    surgeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        surgeButtons.forEach((b) => {
          b.className = 'surge-btn py-2.5 px-3 rounded-lg border border-slate-700 bg-[#0B131E] text-xs font-semibold text-slate-300 hover:border-[#F5B82E] transition-all text-center';
        });
        btn.className = 'surge-btn py-2.5 px-3 rounded-lg border border-[#F5B82E] bg-[#F5B82E]/10 text-xs font-semibold text-[#F5B82E] transition-all text-center';
        currentSurgeFactor = parseFloat(btn.getAttribute('data-factor') || '1.5');
        calculate();
      });
    });

    calculate();
  }

  // Run on DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCalculator);
  } else {
    setupCalculator();
  }
</script>
