---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const articles = await getCollection('artikel');
  return articles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allArticles = await getCollection('artikel');
const otherArticles = allArticles
  .filter((a) => a.slug !== entry.slug)
  .slice(0, 3);

const canonicalUrl = `https://gensetora.com/artikel/${entry.slug}/`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": `https://gensetora.com${entry.data.heroImage}`,
  "datePublished": entry.data.publishDate,
  "author": {
    "@type": "Organization",
    "name": entry.data.author,
    "url": "https://gensetora.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "PT. Gensetora Daya Nusantara",
    "logo": {
      "@type": "ImageObject",
      "url": "https://gensetora.com/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<Layout
  title={`${entry.data.seoTitle || entry.data.title}`}
  description={entry.data.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <Header />

  <main class="min-h-screen bg-white py-12 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium">
        <a href="/" style="min-height: 36px; display: inline-flex; align-items: center;" class="hover:text-[#F5B82E] transition-colors">Beranda</a>
        <span>/</span>
        <a href="/artikel/" style="min-height: 36px; display: inline-flex; align-items: center;" class="hover:text-[#F5B82E] transition-colors">Artikel</a>
        <span>/</span>
        <span class="text-[#0A4347] truncate max-w-xs">{entry.data.category}</span>
      </nav>

      <!-- Article Header -->
      <header class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#009498] text-white text-xs font-bold uppercase tracking-wider mb-4">
          {entry.data.category}
        </div>
        <h1 class="font-heading text-2xl sm:text-4xl lg:text-5xl font-extrabold text-[#0A4347] tracking-normal leading-tight mb-4">
          {entry.data.title}
        </h1>
        <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 border-y border-slate-200 py-3">
          <span>Ditulis oleh: <strong class="text-[#0A4347] font-semibold">{entry.data.author}</strong></span>
          <span>•</span>
          <time datetime={entry.data.publishDate}>Dipublikasikan: {entry.data.publishDate}</time>
          <span>•</span>
          <span class="text-emerald-700 font-semibold">📍 Layanan Daya Seluruh Indonesia</span>
        </div>
      </header>

      <!-- Featured Image -->
      <div class="aspect-video w-full rounded-2xl overflow-hidden bg-slate-900 border border-slate-200 mb-10 shadow-sm">
        <img
          src={entry.data.heroImage}
          alt={`Dokumentasi lapangan ${entry.data.title}`}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>

      <!-- Markdown Prose Content -->
      <article class="prose prose-slate max-w-none prose-headings:font-heading prose-headings:font-bold prose-headings:text-[#0A4347] prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-lg sm:prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-2 prose-p:text-slate-700 prose-p:leading-relaxed prose-p:text-sm sm:prose-p:text-base prose-li:text-slate-700 prose-li:text-sm sm:prose-li:text-base prose-table:text-xs sm:prose-table:text-sm prose-th:bg-slate-100 prose-th:p-3 prose-td:p-3 prose-td:border prose-th:border prose-strong:text-[#0A4347]">
        <Content />
      </article>

      <!-- Tags List -->
      <div class="mt-10 pt-6 border-t border-slate-200 flex flex-wrap gap-2 items-center">
        <span class="text-xs text-slate-500 font-bold uppercase tracking-wider mr-2">Topik Terkait:</span>
        {entry.data.tags.map((tag) => (
          <span class="px-3 py-1 rounded-md bg-slate-100 text-slate-700 text-xs font-medium">
            #{tag}
          </span>
        ))}
      </div>

      <!-- Author Box & Single End-of-Article WhatsApp CTA -->
      <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-[#EFF8F8] border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
        <div class="space-y-1 text-center sm:text-left">
          <div class="text-xs text-slate-500 font-bold uppercase tracking-wider">Konsultasi Daya &amp; Pengadaan Genset</div>
          <h3 class="font-heading font-bold text-lg text-[#0A4347]">Punya Kebutuhan Daya Genset untuk Bisnis Anda?</h3>
          <p class="text-xs text-slate-600 max-w-md">
            Konsultasikan kapasitas kVA, skema sewa harian-bulanan, atau pengadaan unit baru langsung bersama tim teknis Gensetora.
          </p>
        </div>
        <a
          href={`https://wa.me/6285183005070?text=${encodeURIComponent(`Halo Estimator Gensetora, saya membaca artikel "${entry.data.title}" dan ingin konsultasi kebutuhan genset untuk fasilitas saya.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          style="min-height: 48px; display: inline-flex; align-items: center; justify-content: center;"
          class="shrink-0 px-6 py-3.5 rounded-lg bg-[#25D366] hover:bg-[#20bd5a] text-[#063336] font-black text-xs sm:text-sm tracking-wide uppercase shadow-sm transition-colors duration-200 flex items-center gap-2"
        >
          <span>Chat WhatsApp: 0851-8300-5070</span>
          <svg class="w-4 h-4 fill-[#063336]" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.54 1.767.828 2.796.828h.005c3.181 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.766-5.768-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.708 0-3.32-.43-4.743-1.189l-5.257 1.378 1.4-5.118c-.85-1.488-1.341-3.21-1.341-5.043 0-5.514 4.486-10 10-10s10 4.486 10 10z"/>
          </svg>
        </a>
      </div>

      <!-- Related Articles Section -->
      {otherArticles.length > 0 && (
        <section class="mt-16 pt-12 border-t border-slate-200">
          <h3 class="font-heading font-bold text-xl text-[#0A4347] mb-6">
            Panduan Teknik Genset Lainnya
          </h3>
          <div class="grid sm:grid-cols-3 gap-6">
            {otherArticles.map((rel) => (
              <a href={`/artikel/${rel.slug}/`} class="group block space-y-2">
                <div class="aspect-video rounded-xl overflow-hidden bg-slate-900 border border-slate-200">
                  <img
                    src={rel.data.heroImage}
                    alt={`Ilustrasi ${rel.data.title}`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
                <div class="text-xs text-amber-700 font-bold uppercase tracking-wider">
                  {rel.data.category}
                </div>
                <h4 class="text-xs font-bold text-[#0A4347] group-hover:text-[#009498] transition-colors line-clamp-2 leading-snug">
                  {rel.data.title}
                </h4>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>
