---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { allProducts, primtechProducts, vgenProducts } from '../../data/products';
---

<Layout
  title="Katalog Produk Genset Lengkap — PRIMTECH & V-GEN | Gensetora"
  description="Katalog resmi genset baru bergaransi: PRIMTECH Prime Series Diesel 20–500 kVA (Common Rail & Silent Canopy) dan V-GEN Portable Open Type 2.200–8.500 Watt."
>
  <Header />

  <main class="pt-20 sm:pt-24 bg-[#EFF8F8]">
    
    <!-- Hero / Header Banner -->
    <section class="bg-[#0A4347] text-white pt-8 pb-10 sm:pt-12 sm:pb-14 border-b border-[#135D62]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4 uppercase tracking-wider font-semibold">
          <a href="/" style="min-height: 32px; display: inline-flex; align-items: center;" class="hover:text-[#F5B82E] transition-colors">Beranda</a>
          <span>/</span>
          <span class="text-[#F5B82E]">Katalog Produk</span>
        </nav>

        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div class="max-w-2xl space-y-2">
            <span class="text-xs uppercase tracking-widest text-[#F5B82E] font-bold block">
              Katalog Resmi
            </span>
            <h1 class="font-heading text-2xl sm:text-4xl font-black text-white tracking-normal">
              Katalog Genset Industri &amp; Portabel
            </h1>
            <p class="text-xs sm:text-sm text-slate-300">
              PRIMTECH Diesel 20–500 kVA dan V-GEN Portabel 2.200–8.500 W dengan garansi dan uji beban 100%.
            </p>
          </div>

          <!-- Single Important Action Button -->
          <div class="shrink-0">
            <a
              href="#primtech"
              style="min-height: 42px; display: inline-flex; align-items: center;"
              class="px-5 py-2.5 rounded-xl bg-[#F5B82E] hover:bg-[#E5A71D] text-[#0A4347] font-bold text-xs uppercase tracking-wider shadow-md transition-colors"
            >
              <span>Pilih Unit &darr;</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Product Grid Section -->
    <section class="py-16 sm:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Filter Tabs / Brand Switcher -->
        <div class="mb-12 flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-b border-slate-200 pb-6">
          <div class="flex flex-wrap items-center gap-2">
            <a
              href="/produk/"
              style="min-height: 40px; display: inline-flex; align-items: center;"
              class="px-4 py-2 rounded-lg bg-[#009498] text-white text-xs font-bold uppercase tracking-wider shadow-xs"
            >
              Semua Produk ({allProducts.length})
            </a>
            <a
              href="#primtech"
              style="min-height: 40px; display: inline-flex; align-items: center;"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-[#009498] text-slate-700 text-xs font-semibold uppercase tracking-wider transition-colors"
            >
              PRIMTECH Diesel ({primtechProducts.length})
            </a>
            <a
              href="#vgen"
              style="min-height: 40px; display: inline-flex; align-items: center;"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-[#009498] text-slate-700 text-xs font-semibold uppercase tracking-wider transition-colors"
            >
              V-GEN Portable ({vgenProducts.length})
            </a>
          </div>

          <div class="text-xs text-slate-500 font-medium">
            <span>Uji Beban Load Bank 100%</span>
            <span class="mx-2">•</span>
            <span>Garansi Resmi &amp; Teknisi 24 Jam</span>
          </div>
        </div>

        <!-- Section 1: PRIMTECH Prime Series Diesel -->
        <div id="primtech" class="mb-16">
          <div class="mb-8">
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-[#0A4347] text-[#F5B82E] text-xs font-bold uppercase tracking-wider mb-2">
              PRIMTECH Prime Series
            </div>
            <h2 class="font-heading text-2xl sm:text-3xl font-black text-[#0A4347] tracking-normal">
              Genset Diesel Industri PRIMTECH (20 – 500 kVA)
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
              Ditenagai mesin YUNNEI Common Rail, SmartGen Controller, dan bodi Silent Canopy berperedam suara api tahan lama.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {primtechProducts.map((p) => (
              <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-xl hover:border-[#F5B82E] transition-[box-shadow,border-color] duration-200 flex flex-col justify-between group">
                <div>
                  <div class="p-6 bg-slate-50/70 border-b border-slate-100 relative">
                    {p.badge && (
                      <div class="absolute top-3 left-3 z-10">
                        <span class="px-2.5 py-0.5 rounded-full bg-[#0A4347] text-[#F5B82E] text-xs font-bold uppercase tracking-wider">
                          {p.badge}
                        </span>
                      </div>
                    )}
                    <div class="block aspect-square max-w-[220px] mx-auto overflow-hidden group-hover:scale-105 transition-transform duration-300">
                      <img
                        src={p.image}
                        alt={p.name}
                        class="w-full h-full object-contain filter drop-shadow-md"
                        loading="lazy"
                        width="350"
                        height="350"
                      />
                    </div>
                  </div>

                  <div class="p-5 space-y-3">
                    <div>
                      <span class="text-xs font-bold uppercase tracking-wider text-[#F5B82E] block">
                        {p.model}
                      </span>
                      <h3 class="font-heading font-extrabold text-base text-[#0A4347] group-hover:text-[#009498] transition-colors leading-snug mt-0.5">
                        <a href={`/produk/${p.slug}/`}>
                          {p.name}
                        </a>
                      </h3>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs pt-2 border-t border-slate-100">
                      <div class="bg-slate-50 p-2 rounded-lg border border-slate-100">
                        <span class="text-xs text-slate-400 uppercase block font-semibold">Prime Power</span>
                        <strong class="text-[#0A4347] font-extrabold text-xs">{p.ratedOutput.split('(')[0]}</strong>
                      </div>
                      <div class="bg-slate-50 p-2 rounded-lg border border-slate-100">
                        <span class="text-xs text-slate-400 uppercase block font-semibold">Standby Power</span>
                        <strong class="text-slate-800 font-bold text-xs">{p.maxOutput.split('(')[0]}</strong>
                      </div>
                    </div>

                    <div class="pt-1 border-t border-slate-100 text-xs flex justify-between text-slate-500">
                      <span>Mesin:</span>
                      <strong class="text-slate-700 truncate max-w-[140px]">{p.engine?.split('(')[0]}</strong>
                    </div>
                  </div>
                </div>

                <div class="p-5 pt-0">
                  <a
                    href={`/produk/${p.slug}/`}
                    class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-lg bg-[#009498] hover:bg-[#007D81] text-white text-xs font-bold tracking-wider uppercase transition-colors"
                  >
                    <span>Lihat Spesifikasi &rarr;</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Section 2: V-GEN Portable Open Type -->
        <div id="vgen" class="pt-8 border-t border-slate-200">
          <div class="mb-8">
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-[#0A4347] text-[#F5B82E] text-xs font-bold uppercase tracking-wider mb-2">
              V-GEN Portable Open Type
            </div>
            <h2 class="font-heading text-2xl sm:text-3xl font-black text-[#0A4347] tracking-normal">
              Genset Bensin Portable V-GEN (2.200 – 8.500 W)
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
              Genset bensin open-frame ringkas untuk UMKM, ruko, restoran, food truck, serta varian industri 3-Phase 380V.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {vgenProducts.map((p) => (
              <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-xl hover:border-[#F5B82E] transition-[box-shadow,border-color] duration-200 flex flex-col justify-between group">
                <div>
                  <div class="p-6 bg-slate-50/70 border-b border-slate-100 relative">
                    {p.badge && (
                      <div class="absolute top-4 left-4 z-10">
                        <span class="px-3 py-1 rounded-full bg-[#0A4347] text-[#F5B82E] text-xs font-bold uppercase tracking-wider">
                          {p.badge}
                        </span>
                      </div>
                    )}
                    <div class="absolute top-4 right-4 z-10">
                      <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-700 text-xs font-bold">
                        {p.voltage}
                      </span>
                    </div>

                    <div class="block aspect-square max-w-[260px] mx-auto overflow-hidden group-hover:scale-105 transition-transform duration-300">
                      <img
                        src={p.image}
                        alt={p.name}
                        class="w-full h-full object-contain filter drop-shadow-md"
                        loading="lazy"
                        width="380"
                        height="380"
                      />
                    </div>
                  </div>

                  <div class="p-6 space-y-3">
                    <div>
                      <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">
                        {p.model}
                      </span>
                      <h3 class="font-heading font-extrabold text-xl text-[#0A4347] group-hover:text-[#009498] transition-colors leading-snug mt-0.5">
                        <a href={`/produk/${p.slug}/`}>
                          {p.name}
                        </a>
                      </h3>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs pt-2 border-t border-slate-100">
                      <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                        <span class="text-xs text-slate-400 uppercase block font-semibold">Max Output</span>
                        <strong class="text-slate-900 font-extrabold text-xs text-[#0A4347]">{p.maxOutput}</strong>
                      </div>
                      <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                        <span class="text-xs text-slate-400 uppercase block font-semibold">Rated Output</span>
                        <strong class="text-slate-800 font-bold text-xs">{p.ratedOutput}</strong>
                      </div>
                    </div>

                    <div class="pt-1 border-t border-slate-100 text-xs flex justify-between text-slate-600">
                      <span>Voltase: <strong class="text-slate-800">{p.voltage}</strong></span>
                      <span>Tangki: <strong class="text-slate-800">{p.fuelTank}</strong></span>
                    </div>
                  </div>
                </div>

                <div class="p-6 pt-0">
                  <a
                    href={`/produk/${p.slug}/`}
                    class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-lg bg-[#009498] hover:bg-[#007D81] text-white text-xs font-bold tracking-wider uppercase transition-colors shadow-xs"
                  >
                    <span>Lihat Spesifikasi &rarr;</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>
