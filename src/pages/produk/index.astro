---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { allProducts, primtechProducts, vgenProducts } from '../../data/products';
---

<Layout
  title="Katalog Genset, Silent Box & Jasa Fabrikasi Metal - Gensetora"
  description="Katalog resmi genset baru bergaransi: PRIMTECH Diesel 20–500 kVA, V-GEN Portable 2.200–8.500 W, Pembuatan Silent Box Genset Custom, Silent Canopy & Attenuator, serta Jasa Tekuk, Plong & Laser Cutting Metal CNC."
>
  <Header />

  <main class="pt-20 sm:pt-24 bg-[#EFF8F8]">
    
    <!-- Hero / Header Banner -->
    <section class="bg-[#0A4347] text-white pt-8 pb-10 sm:pt-12 sm:pb-14 border-b border-[#135D62]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4 uppercase tracking-wider font-semibold">
          <a href="/" style="min-height: 32px; display: inline-flex; align-items: center;" class="hover:text-[#F5B82E] transition-colors">Beranda</a>
          <span>/</span>
          <span class="text-[#F5B82E]">Katalog Produk &amp; Fabrikasi</span>
        </nav>

        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div class="max-w-2xl space-y-2">
            <span class="text-xs uppercase tracking-widest text-[#F5B82E] font-bold block">
              Katalog Resmi
            </span>
            <h1 class="font-heading text-2xl sm:text-4xl font-black text-white tracking-normal">
              Katalog Genset, Silent Box &amp; Fabrikasi Metal
            </h1>
            <p class="text-xs sm:text-sm text-slate-300">
              PRIMTECH Diesel 20–500 kVA, V-GEN Portabel 2.200–8.500 W, Pembuatan Silent Box Genset Custom, Silent Canopy &amp; Attenuator, serta Jasa Tekuk, Plong &amp; CNC Laser Cutting Metal.
            </p>
          </div>

          <!-- Single Important Action Button -->
          <div class="shrink-0">
            <a
              href="#primtech"
              style="min-height: 42px; display: inline-flex; align-items: center;"
              class="px-5 py-2.5 rounded-xl bg-[#F5B82E] hover:bg-[#E5A71D] text-[#0A4347] font-bold text-xs uppercase tracking-wider shadow-md transition-colors"
            >
              <span>Pilih Unit &darr;</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Product Grid Section -->
    <section class="py-16 sm:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Filter Tabs / Brand Switcher -->
        <div class="mb-12 flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-b border-slate-200 pb-6">
          <div class="flex flex-wrap items-center gap-2">
            <a
              href="/produk/"
              style="min-height: 40px; display: inline-flex; align-items: center;"
              class="px-4 py-2 rounded-lg bg-[#009498] text-white text-xs font-bold uppercase tracking-wider shadow-xs"
            >
              Semua Produk &amp; Layanan
            </a>
            <a
              href="#primtech"
              style="min-height: 40px; display: inline-flex; align-items: center;"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-[#009498] text-slate-700 text-xs font-semibold uppercase tracking-wider transition-colors"
            >
              PRIMTECH Diesel ({primtechProducts.length})
            </a>
            <a
              href="#vgen"
              style="min-height: 40px; display: inline-flex; align-items: center;"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-[#009498] text-slate-700 text-xs font-semibold uppercase tracking-wider transition-colors"
            >
              V-GEN Portable ({vgenProducts.length})
            </a>
            <a
              href="#fabrikasi-metal"
              style="min-height: 40px; display: inline-flex; align-items: center;"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-[#009498] text-slate-700 text-xs font-semibold uppercase tracking-wider transition-colors"
            >
              Silent Box &amp; Fabrikasi Metal
            </a>
          </div>

          <div class="text-xs text-slate-500 font-medium">
            <span>Uji Beban Load Bank 100%</span>
            <span class="mx-2">•</span>
            <span>Garansi Resmi &amp; Teknisi 24 Jam</span>
          </div>
        </div>

        <!-- Section 1: PRIMTECH Prime Series Diesel -->
        <div id="primtech" class="mb-16">
          <div class="mb-8">
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-[#0A4347] text-[#F5B82E] text-xs font-bold uppercase tracking-wider mb-2">
              PRIMTECH Prime Series
            </div>
            <h2 class="font-heading text-2xl sm:text-3xl font-black text-[#0A4347] tracking-normal">
              Genset Diesel Industri PRIMTECH (20 – 500 kVA)
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
              Ditenagai mesin YUNNEI Common Rail, SmartGen Controller, dan bodi Silent Canopy berperedam suara api tahan lama.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {primtechProducts.map((p) => (
              <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-xl hover:border-[#F5B82E] transition-[box-shadow,border-color] duration-200 flex flex-col justify-between group">
                <div>
                  <div class="p-6 bg-slate-50/70 border-b border-slate-100 relative">
                    {p.badge && (
                      <div class="absolute top-3 left-3 z-10">
                        <span class="px-2.5 py-0.5 rounded-full bg-[#0A4347] text-[#F5B82E] text-xs font-bold uppercase tracking-wider">
                          {p.badge}
                        </span>
                      </div>
                    )}
                    <div class="block aspect-square max-w-[220px] mx-auto overflow-hidden group-hover:scale-105 transition-transform duration-300">
                      <img
                        src={p.image}
                        alt={p.name}
                        class="w-full h-full object-contain filter drop-shadow-md"
                        loading="lazy"
                        width="350"
                        height="350"
                      />
                    </div>
                  </div>

                  <div class="p-5 space-y-3">
                    <div>
                      <span class="text-xs font-bold uppercase tracking-wider text-[#F5B82E] block">
                        {p.model}
                      </span>
                      <h3 class="font-heading font-extrabold text-base text-[#0A4347] group-hover:text-[#009498] transition-colors leading-snug mt-0.5">
                        <a href={`/produk/${p.slug}/`}>
                          {p.name}
                        </a>
                      </h3>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs pt-2 border-t border-slate-100">
                      <div class="bg-slate-50 p-2 rounded-lg border border-slate-100">
                        <span class="text-xs text-slate-400 uppercase block font-semibold">Prime Power</span>
                        <strong class="text-[#0A4347] font-extrabold text-xs">{p.ratedOutput.split('(')[0]}</strong>
                      </div>
                      <div class="bg-slate-50 p-2 rounded-lg border border-slate-100">
                        <span class="text-xs text-slate-400 uppercase block font-semibold">Standby Power</span>
                        <strong class="text-slate-800 font-bold text-xs">{p.maxOutput.split('(')[0]}</strong>
                      </div>
                    </div>

                    <div class="pt-1 border-t border-slate-100 text-xs flex justify-between text-slate-500">
                      <span>Mesin:</span>
                      <strong class="text-slate-700 truncate max-w-[140px]">{p.engine?.split('(')[0]}</strong>
                    </div>
                  </div>
                </div>

                <div class="p-5 pt-0">
                  <a
                    href={`/produk/${p.slug}/`}
                    class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-lg bg-[#009498] hover:bg-[#007D81] text-white text-xs font-bold tracking-wider uppercase transition-colors"
                  >
                    <span>Lihat Spesifikasi &rarr;</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Section 2: V-GEN Portable Open Type -->
        <div id="vgen" class="pt-8 border-t border-slate-200">
          <div class="mb-8">
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-[#0A4347] text-[#F5B82E] text-xs font-bold uppercase tracking-wider mb-2">
              V-GEN Portable Open Type
            </div>
            <h2 class="font-heading text-2xl sm:text-3xl font-black text-[#0A4347] tracking-normal">
              Genset Bensin Portable V-GEN (2.200 – 8.500 W)
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
              Genset bensin open-frame ringkas untuk UMKM, ruko, restoran, food truck, serta varian industri 3-Phase 380V.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {vgenProducts.map((p) => (
              <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-xl hover:border-[#F5B82E] transition-[box-shadow,border-color] duration-200 flex flex-col justify-between group">
                <div>
                  <div class="p-6 bg-slate-50/70 border-b border-slate-100 relative">
                    {p.badge && (
                      <div class="absolute top-4 left-4 z-10">
                        <span class="px-3 py-1 rounded-full bg-[#0A4347] text-[#F5B82E] text-xs font-bold uppercase tracking-wider">
                          {p.badge}
                        </span>
                      </div>
                    )}
                    <div class="absolute top-4 right-4 z-10">
                      <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-700 text-xs font-bold">
                        {p.voltage}
                      </span>
                    </div>

                    <div class="block aspect-square max-w-[260px] mx-auto overflow-hidden group-hover:scale-105 transition-transform duration-300">
                      <img
                        src={p.image}
                        alt={p.name}
                        class="w-full h-full object-contain filter drop-shadow-md"
                        loading="lazy"
                        width="380"
                        height="380"
                      />
                    </div>
                  </div>

                  <div class="p-6 space-y-3">
                    <div>
                      <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">
                        {p.model}
                      </span>
                      <h3 class="font-heading font-extrabold text-xl text-[#0A4347] group-hover:text-[#009498] transition-colors leading-snug mt-0.5">
                        <a href={`/produk/${p.slug}/`}>
                          {p.name}
                        </a>
                      </h3>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs pt-2 border-t border-slate-100">
                      <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                        <span class="text-xs text-slate-400 uppercase block font-semibold">Max Output</span>
                        <strong class="text-slate-900 font-extrabold text-xs text-[#0A4347]">{p.maxOutput}</strong>
                      </div>
                      <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                        <span class="text-xs text-slate-400 uppercase block font-semibold">Rated Output</span>
                        <strong class="text-slate-800 font-bold text-xs">{p.ratedOutput}</strong>
                      </div>
                    </div>

                    <div class="pt-1 border-t border-slate-100 text-xs flex justify-between text-slate-600">
                      <span>Voltase: <strong class="text-slate-800">{p.voltage}</strong></span>
                      <span>Tangki: <strong class="text-slate-800">{p.fuelTank}</strong></span>
                    </div>
                  </div>
                </div>

                <div class="p-6 pt-0">
                  <a
                    href={`/produk/${p.slug}/`}
                    class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-lg bg-[#009498] hover:bg-[#007D81] text-white text-xs font-bold tracking-wider uppercase transition-colors shadow-xs"
                  >
                    <span>Lihat Spesifikasi &rarr;</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Section 3: Fabrikasi Silent Box, Canopy, Attenuator & Sheet Metal CNC -->
        <div id="fabrikasi-metal" class="pt-10 border-t border-slate-200">
          <div class="mb-10 max-w-3xl">
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-[#0A4347] text-[#F5B82E] text-xs font-bold uppercase tracking-wider mb-2">
              Fabrikasi &amp; Pengerjaan Metal
            </div>
            <h2 class="font-heading text-2xl sm:text-3xl font-black text-[#0A4347] tracking-normal">
              Pembuatan Silent Box, Canopy &amp; Jasa Sheet Metal CNC
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
              Layanan rekayasa akustik untuk mereduksi kebisingan genset (custom silent box portable &amp; industri, soundproof canopy, serta intake-discharge attenuator) dan pengerjaan sheet metal industri presisi dengan mesin CNC fiber laser, press brake bending, serta turret punch.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            
            <!-- Card 1: Silent Box Genset Custom (Peredam Suara Mesin) -->
            <div class="bg-white rounded-2xl border border-slate-200/90 shadow-md overflow-hidden flex flex-col justify-between hover:border-[#009498] transition-colors">
              <div>
                <!-- Image Preview Header -->
                <div class="relative bg-slate-100 aspect-[16/9] overflow-hidden border-b border-slate-100">
                  <img
                    src="/images/machine-silent.webp"
                    alt="Silent Box Genset Custom Peredam Suara Gensetora"
                    class="w-full h-full object-cover filter brightness-[0.98]"
                    loading="lazy"
                    width="600"
                    height="338"
                  />
                  <div class="absolute top-4 left-4">
                    <span class="px-3 py-1 rounded-full bg-[#0A4347] text-[#F5B82E] text-xs font-bold uppercase tracking-wider shadow-sm">
                      Solusi Bising Genset
                    </span>
                  </div>
                  <div class="absolute bottom-3 right-3 bg-[#063336]/90 backdrop-blur-xs text-white text-xs px-3 py-1 rounded-md font-semibold">
                    Portabel s/d 500 kVA
                  </div>
                </div>

                <div class="p-6 space-y-5">
                  <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-[#009498] block">
                      Enclosure Peredam Suara Kustom
                    </span>
                    <h3 class="font-heading font-black text-xl text-[#0A4347] leading-snug mt-1">
                      Silent Box Genset Custom (Peredam Suara)
                    </h3>
                    <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                      Suara genset mengganggu lingkungan kerja atau operasional perusahaan? Kami memproduksi Silent Box Genset custom untuk meredam kebisingan secara maksimal pada pabrik, gedung kantor, ruko, klinik, kafe, workshop, dan pemukiman.
                    </p>
                  </div>

                  <!-- Spec Points -->
                  <div class="space-y-2.5 bg-[#EFF8F8] p-4 rounded-xl border border-slate-200 text-xs text-slate-700">
                    <div class="font-bold text-[#0A4347] uppercase tracking-wider text-[11px] pb-1 border-b border-slate-200">
                      Spesifikasi Konstruksi Box
                    </div>
                    <div class="space-y-1.5">
                      <div>
                        <span class="text-slate-500 block">Material Bodi:</span>
                        <strong class="text-slate-900 font-bold">Plat Baja SPHC/SPCC 2.0 mm (CNC Cut)</strong>
                      </div>
                      <div>
                        <span class="text-slate-500 block">Lapisan Peredam:</span>
                        <strong class="text-slate-900 font-bold">Rockwool High-Density 80–100 kg/m³</strong>
                      </div>
                      <div>
                        <span class="text-slate-500 block">Sirkulasi Udara:</span>
                        <strong class="text-slate-900 font-bold">Ventilasi Labirin Anti-Overheat</strong>
                      </div>
                      <div>
                        <span class="text-slate-500 block">Reduksi Bising:</span>
                        <strong class="text-emerald-700 font-bold">Turun 60% – 80% (&lt; 65 dB Ramah Lingkungan)</strong>
                      </div>
                      <div>
                        <span class="text-slate-500 block">Akses Operasional:</span>
                        <strong class="text-slate-900 font-bold">Pintu Starter, Panel &amp; Tangki BBM</strong>
                      </div>
                      <div>
                        <span class="text-slate-500 block">Mobilitas:</span>
                        <strong class="text-slate-900 font-bold">Handle Samping + Opsi Roda Rem</strong>
                      </div>
                    </div>
                  </div>

                  <!-- Feature Checkmarks -->
                  <div class="space-y-1.5 text-xs text-slate-600">
                    <div class="flex items-start gap-2">
                      <span class="text-[#009498] font-bold">✓</span>
                      <span>Dibuat presisi custom mengikuti dimensi unit genset Anda</span>
                    </div>
                    <div class="flex items-start gap-2">
                      <span class="text-[#009498] font-bold">✓</span>
                      <span>Sirkulasi udara labirin menjaga suhu mesin tetap dingin</span>
                    </div>
                    <div class="flex items-start gap-2">
                      <span class="text-[#009498] font-bold">✓</span>
                      <span>Kenyamanan kerja dan lingkungan sekitar bebas polusi bising</span>
                    </div>
                    <div class="flex items-start gap-2">
                      <span class="text-[#009498] font-bold">✓</span>
                      <span>Finishing oven powder coating tahan karat indoor/outdoor</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="p-6 pt-0">
                <a
                  href="https://wa.me/6285183005070?text=Halo%20Gensetora,%20saya%20tertarik%20pembuatan%20Silent%20Box%20Genset%20custom%20untuk%20meredam%20suara%20genset%20saya.%20Mohon%20info%20estimasi%20harga%20dan%20ukurannya."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-[#0A4347] hover:bg-[#074549] text-white text-xs font-bold uppercase tracking-wider transition-colors duration-200 shadow-md group"
                >
                  <span>Konsultasi Silent Box Genset</span>
                  <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </a>
              </div>
            </div>

            <!-- Card 2: Pembuatan Canopy & Silence Genset atau Attenuator -->
            <div class="bg-white rounded-2xl border border-slate-200/90 shadow-md overflow-hidden flex flex-col justify-between hover:border-[#009498] transition-colors">
              <div>
                <!-- Image Preview Header -->
                <div class="relative bg-slate-100 aspect-[16/9] overflow-hidden border-b border-slate-100">
                  <img
                    src="/images/machine-silent-studio.webp"
                    alt="Pembuatan Canopy dan Silence Genset Sound Attenuator Gensetora"
                    class="w-full h-full object-cover filter brightness-[0.98]"
                    loading="lazy"
                    width="600"
                    height="338"
                  />
                  <div class="absolute top-4 left-4">
                    <span class="px-3 py-1 rounded-full bg-[#0A4347] text-[#F5B82E] text-xs font-bold uppercase tracking-wider shadow-sm">
                      Noise Reduction &lt; 68 dB
                    </span>
                  </div>
                  <div class="absolute bottom-3 right-3 bg-[#063336]/90 backdrop-blur-xs text-white text-xs px-3 py-1 rounded-md font-semibold">
                    10 kVA – 2.000 kVA
                  </div>
                </div>

                <div class="p-6 space-y-5">
                  <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-[#009498] block">
                      Spesialis Akustik &amp; Enclosure
                    </span>
                    <h3 class="font-heading font-black text-xl text-[#0A4347] leading-snug mt-1">
                      Pembuatan Canopy &amp; Sound Attenuator
                    </h3>
                    <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                      Fabrikasi kustom bodi silent canopy baru untuk konversi genset open type ke silent type, perbaikan bodi lama keropos, serta instalasi sound attenuator intake/discharge louver untuk ruang genset gedung dan pabrik.
                    </p>
                  </div>

                  <!-- Spec Points -->
                  <div class="space-y-2.5 bg-[#EFF8F8] p-4 rounded-xl border border-slate-200 text-xs text-slate-700">
                    <div class="font-bold text-[#0A4347] uppercase tracking-wider text-[11px] pb-1 border-b border-slate-200">
                      Spesifikasi Konstruksi &amp; Material
                    </div>
                    <div class="space-y-1.5">
                      <div>
                        <span class="text-slate-500 block">Material Plat Bodi:</span>
                        <strong class="text-slate-900 font-bold">Plat Baja SPHC/SPCC 2.0 – 3.2 mm</strong>
                      </div>
                      <div>
                        <span class="text-slate-500 block">Insulasi Akustik:</span>
                        <strong class="text-slate-900 font-bold">Rockwool Density 80–100 kg/m³</strong>
                      </div>
                      <div>
                        <span class="text-slate-500 block">Finishing Proteksi:</span>
                        <strong class="text-slate-900 font-bold">Anti-Rust &amp; Oven Powder Coating</strong>
                      </div>
                      <div>
                        <span class="text-slate-500 block">Pelindung Dalam:</span>
                        <strong class="text-slate-900 font-bold">Glass Cloth + Perforated Plate</strong>
                      </div>
                      <div>
                        <span class="text-slate-500 block">Sistem Attenuator:</span>
                        <strong class="text-slate-900 font-bold">Intake &amp; Discharge Splitter Louver</strong>
                      </div>
                      <div>
                        <span class="text-slate-500 block">Tingkat Kebisingan:</span>
                        <strong class="text-emerald-700 font-bold">&lt; 65 – 70 dB (Jarak 7 Meter)</strong>
                      </div>
                    </div>
                  </div>

                  <!-- Feature Checkmarks -->
                  <div class="space-y-1.5 text-xs text-slate-600">
                    <div class="flex items-start gap-2">
                      <span class="text-[#009498] font-bold">✓</span>
                      <span>Ukuran presisi custom mengikuti dimensi unit genset</span>
                    </div>
                    <div class="flex items-start gap-2">
                      <span class="text-[#009498] font-bold">✓</span>
                      <span>Ducting airflow aerodinamis agar mesin tetap dingin</span>
                    </div>
                    <div class="flex items-start gap-2">
                      <span class="text-[#009498] font-bold">✓</span>
                      <span>Pintu akses perawatan luas dengan kunci stainless steel</span>
                    </div>
                    <div class="flex items-start gap-2">
                      <span class="text-[#009498] font-bold">✓</span>
                      <span>Pilihan silencer: Industrial, Residential, atau Critical</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="p-6 pt-0">
                <a
                  href="https://wa.me/6285183005070?text=Halo%20Gensetora,%20saya%20ingin%20konsultasi%20pembuatan%20Canopy%20Genset%20atau%20Sound%20Attenuator%20untuk%20unit%20saya.%20Mohon%20informasi%20estimasi%20biaya%20dan%20waktu%20pengerjaannya."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-[#0A4347] hover:bg-[#074549] text-white text-xs font-bold uppercase tracking-wider transition-colors duration-200 shadow-md group"
                >
                  <span>Konsultasi Canopy &amp; Attenuator</span>
                  <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </a>
              </div>
