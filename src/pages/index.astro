---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import SpotlightMachine from '../components/SpotlightMachine.astro';
import PrimtechDieselSection from '../components/PrimtechDieselSection.astro';
import VGenPortableSection from '../components/VGenPortableSection.astro';
import Services from '../components/Services.astro';
import Calculator from '../components/Calculator.astro';
import DifferenceSlider from '../components/DifferenceSlider.astro';
import Projects from '../components/Projects.astro';
import ConsultationGallery from '../components/ConsultationGallery.astro';
import ArticleSection from '../components/ArticleSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="GENSETORA — Complete Generator & Power Solutions Indonesia"
  description="Pusat solusi genset terpadu kapasitas 1 kVA – 2.000 kVA di Indonesia: Jual unit baru bergaransi, sewa harian-bulanan, service overhaul, dan maintenance berkala resmi."
>
  <Header />
  <main id="top">
    <Hero />
    <TrustStrip />
    <SpotlightMachine />
    <PrimtechDieselSection />
    <VGenPortableSection />
    <Services />
    <Calculator />
    <DifferenceSlider />
    <Projects />
    <ConsultationGallery />
    <ArticleSection />
  </main>
  <Footer />
</Layout>
